# Non-secret production settings. Store credentials and keys in separate 0600 files.
DEPLOYMENT_ENVIRONMENT=production
PUBLIC_WEB_URL=https://ehr.example.org
API_PUBLIC_URL=https://ehr.example.org
CORS_ORIGINS=https://ehr.example.org
ALLOWED_HOSTS=ehr.example.org
TRUSTED_PROXY_IPS=172.20.0.0/16
OPENRM_RELEASE=v1.0.0
OPENRM_HTTP_PORT=8080
# Use immutable registry digests produced by the release workflow.
OPENRM_API_IMAGE=ghcr.io/organization/openrm-api@sha256:replace
OPENRM_WEB_IMAGE=ghcr.io/organization/openrm-web@sha256:replace

POSTGRES_PASSWORD_FILE=/secure/openrm/postgres-password
DATABASE_URL_FILE=/secure/openrm/database-url
JWT_SECRET_FILE=/secure/openrm/jwt-secret
MFA_ENCRYPTION_KEY_FILE=/secure/openrm/mfa-fernet-key
SMART_OIDC_PRIVATE_KEY_FILE=/secure/openrm/smart-oidc-private.pem

# Backup settings are used only with the operations profile.
BACKUP_DIRECTORY=/secure/openrm/backups
AGE_RECIPIENT=age1replacewiththeofflinebackuprecipient
