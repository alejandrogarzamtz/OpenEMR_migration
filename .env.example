DEPLOYMENT_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://openemr:openemr@db:5432/openemr
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_SECONDS=60
MFA_CHALLENGE_MINUTES=5
IP_MAX_FAILED_LOGINS=5
IP_FAILURE_WINDOW_MINUTES=15
# Generate independently with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=
PORTAL_APPOINTMENTS_ENABLED=true
PORTAL_RESULTS_ENABLED=true
PORTAL_DOCUMENTS_ENABLED=true
PORTAL_FORMS_ENABLED=true
PORTAL_BILLING_ENABLED=true
PAYMENT_PROVIDER=disabled
BILLING_CURRENCY=USD
SIMPLIFIED_DEMOGRAPHICS=false
IPPF_SPECIFIC=false
SECURE_COOKIES=false
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Development bootstrap only. Omit both variables in production.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-development-password
